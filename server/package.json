{
  "name": "insurance-claims-sop-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/api/server.js",
    "test": "vitest run --exclude '**/*.live.test.ts'",
    "test:live": "vitest run live.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
