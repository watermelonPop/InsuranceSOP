PORT=4000

# LLM provider config (provider-agnostic layer picks the adapter based on LLM_PROVIDER)
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional override of the default Groq model (see DECISIONS.md #1):
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini is still supported as an alternate provider (see DECISIONS.md #1
# for why it's not the default — its free-tier flash models hit a hard
# 20 requests/day cap). Set LLM_PROVIDER=gemini and fill this in to use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Placeholders for future providers, if you switch LLM_PROVIDER:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Which consent_scenarios.json entry to simulate for a representative call's
# authorization check (see DECISIONS.md #23). Defaults to "default" (quick
# approval). Set to "timeout" to demo the stuck-pending/denied path.
# CONSENT_SCENARIO=default
